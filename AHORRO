import React, { useState, useEffect } from 'react';
import { Check, Download, Settings, Calendar, TrendingUp, Target, Zap, Star, BarChart3, PiggyBank, DollarSign, Trophy, Award, Medal, Crown, Gem } from 'lucide-react';

const SavingsTrackerPro = () => {
  const [goalAmount, setGoalAmount] = useState(2500000);
  const [totalMonths, setTotalMonths] = useState(5);
  const [savings, setSavings] = useState({});
  const [activeView, setActiveView] = useState('dashboard');
  const [showConfig, setShowConfig] = useState(false);
  const [showAchievements, setShowAchievements] = useState(false);
  const [theme, setTheme] = useState('gradient');

  const totalDays = totalMonths * 30;

  const generateOptimalPlan = () => {
    const amounts = {};
    const dailyBase = goalAmount / totalDays;
    
    for (let month = 1; month <= totalMonths; month++) {
      const monthMultiplier = 0.4 + (month / totalMonths) * 1.2;
      const startDay = (month - 1) * 30 + 1;
      const endDay = Math.min(month * 30, totalDays);
      
      for (let day = startDay; day <= endDay; day++) {
        const dayInMonth = day - startDay + 1;
        const weekMultiplier = 1 + (Math.floor((dayInMonth - 1) / 7) * 0.15);
        amounts[day] = Math.floor(dailyBase * monthMultiplier * weekMultiplier);
      }
    }
    return amounts;
  };

  const dailyAmounts = generateOptimalPlan();

  const updateSaving = (day, field, value) => {
    setSavings(prev => ({
      ...prev,
      [day]: { ...prev[day], [field]: value }
    }));
  };

  const toggleCompleted = (day) => {
    const completed = !(savings[day]?.completed || false);
    updateSaving(day, 'completed', completed);
    if (completed && !savings[day]?.actualAmount) {
      updateSaving(day, 'actualAmount', dailyAmounts[day]);
    }
  };

  const calculateAdvancedStats = () => {
    let totalSaved = 0, completedDays = 0, streak = 0, bestDay = 0;
    let weeklyData = [], monthlyData = [];
    
    for (let month = 1; month <= totalMonths; month++) {
      let monthSaved = 0, monthCompleted = 0, monthGoal = 0;
      const startDay = (month - 1) * 30 + 1;
      const endDay = Math.min(month * 30, totalDays);
      
      for (let day = startDay; day <= endDay; day++) {
        const planned = dailyAmounts[day] || 0;
        const actual = savings[day]?.actualAmount || 0;
        const completed = savings[day]?.completed || false;
        
        monthGoal += planned;
        if (completed) {
          totalSaved += actual;
          completedDays++;
          monthSaved += actual;
          monthCompleted++;
          bestDay = Math.max(bestDay, actual);
        }
      }
      
      monthlyData.push({
        month,
        saved: monthSaved,
        goal: monthGoal,
        completed: monthCompleted,
        total: endDay - startDay + 1
      });
    }

    return {
      totalSaved, completedDays, streak, bestDay, monthlyData,
      progress: (totalSaved / goalAmount) * 100,
      efficiency: completedDays > 0 ? (totalSaved / (completedDays * (goalAmount / totalDays))) * 100 : 0,
      projection: completedDays > 0 ? (totalSaved / completedDays) * totalDays : 0
    };
  };

  const stats = calculateAdvancedStats();

  const calculateAchievements = () => {
    const achievements = [
      {
        id: 'first_save',
        name: '🎯 Primer Paso',
        description: 'Completa tu primer día de ahorro',
        unlocked: stats.completedDays >= 1,
        rarity: 'common',
        points: 50
      },
      {
        id: 'week_streak',
        name: '🔥 Semana Consistente',
        description: 'Ahorra durante 7 días consecutivos',
        unlocked: stats.completedDays >= 7,
        rarity: 'uncommon',
        points: 100
      },
      {
        id: 'month_complete',
        name: '📅 Mes Perfecto',
        description: 'Completa un mes completo de ahorros',
        unlocked: stats.completedDays >= 30,
        rarity: 'rare',
        points: 300
      },
      {
        id: 'halfway_hero',
        name: '⭐ Héroe de Medio Camino',
        description: 'Alcanza el 50% de tu meta',
        unlocked: stats.progress >= 50,
        rarity: 'rare',
        points: 500
      },
      {
        id: 'overachiever',
        name: '🚀 Súper Ahorrador',
        description: 'Supera tu meta diaria por 3 días seguidos',
        unlocked: (() => {
          let streak = 0;
          let maxStreak = 0;
          for (let day = 1; day <= totalDays; day++) {
            const planned = dailyAmounts[day] || 0;
            const actual = savings[day]?.actualAmount || 0;
            if (actual > planned) {
              streak++;
              maxStreak = Math.max(maxStreak, streak);
            } else {
              streak = 0;
            }
          }
          return maxStreak >= 3;
        })(),
        rarity: 'epic',
        points: 750
      },
      {
        id: 'efficiency_master',
        name: '⚡ Maestro de Eficiencia',
        description: 'Mantén una eficiencia del 120% o más',
        unlocked: stats.efficiency >= 120,
        rarity: 'epic',
        points: 1000
      },
      {
        id: 'goal_crusher',
        name: '💎 Aplasta Metas',
        description: 'Completa tu meta de ahorro',
        unlocked: stats.progress >= 100,
        rarity: 'legendary',
        points: 2000
      },
      {
        id: 'consistency_king',
        name: '👑 Rey de la Consistencia',
        description: 'No falles ni un solo día',
        unlocked: stats.completedDays === totalDays && stats.completedDays > 0,
        rarity: 'legendary',
        points: 3000
      },
      {
        id: 'big_saver',
        name: '🏦 Gran Ahorrador',
        description: 'Ahorra más de $100,000 en un día',
        unlocked: (() => {
          for (let day = 1; day <= totalDays; day++) {
            if ((savings[day]?.actualAmount || 0) > 100000) return true;
          }
          return false;
        })(),
        rarity: 'rare',
        points: 400
      },
      {
        id: 'early_bird',
        name: '🌅 Madrugador',
        description: 'Completa los primeros 5 días',
        unlocked: (() => {
          for (let day = 1; day <= 5; day++) {
            if (!(savings[day]?.completed)) return false;
          }
          return totalDays >= 5;
        })(),
        rarity: 'uncommon',
        points: 200
      }
    ];

    return achievements;
  };

  const achievements = calculateAchievements();
  const unlockedAchievements = achievements.filter(a => a.unlocked);
  const totalPoints = unlockedAchievements.reduce((sum, a) => sum + a.points, 0);

  const formatCurrency = (amount) => {
    return new Intl.NumberFormat('es-CO', {
      style: 'currency', currency: 'COP', minimumFractionDigits: 0
    }).format(amount);
  };

  const getMonthDays = (month) => {
    const start = (month - 1) * 30 + 1;
    const end = Math.min(month * 30, totalDays);
    return Array.from({length: end - start + 1}, (_, i) => start + i);
  };

  const handleExportCSV = () => {
    const headers = ['Día', 'Mes', 'Fecha', 'Meta', 'Ahorrado', 'Completado', 'Diferencia'];
    const rows = [headers.join(',')];
    
    for (let day = 1; day <= totalDays; day++) {
      const month = Math.ceil(day / 30);
      const planned = dailyAmounts[day] || 0;
      const actual = savings[day]?.actualAmount || 0;
      const completed = savings[day]?.completed || false;
      const date = savings[day]?.date || '';
      const difference = actual - planned;
      
      rows.push([day, month, date, planned, actual, completed ? 'Sí' : 'No', difference].join(','));
    }
    
    const csvContent = rows.join('\n');
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `plan-ahorro-${goalAmount}-${totalMonths}meses.csv`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    window.URL.revokeObjectURL(url);
  };

  const handleExportJSON = () => {
    const exportData = {
      configuracion: {
        meta: goalAmount,
        meses: totalMonths,
        fechaCreacion: new Date().toISOString()
      },
      estadisticas: stats,
      ahorros: savings,
      planDiario: dailyAmounts
    };
    
    const jsonContent = JSON.stringify(exportData, null, 2);
    const blob = new Blob([jsonContent], { type: 'application/json' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `datos-ahorro-${new Date().toISOString().split('T')[0]}.json`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    window.URL.revokeObjectURL(url);
  };

  const handleExportPDF = () => {
    const htmlContent = `
      <!DOCTYPE html>
      <html>
      <head>
        <meta charset="UTF-8">
        <title>Plan de Ahorro - Reporte</title>
        <style>
          body { font-family: Arial, sans-serif; margin: 20px; }
          .header { text-align: center; margin-bottom: 30px; }
          .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-bottom: 30px; }
          .stat-card { padding: 15px; border: 1px solid #ddd; border-radius: 8px; }
          .table { width: 100%; border-collapse: collapse; }
          .table th, .table td { border: 1px solid #ddd; padding: 8px; text-align: left; }
          .table th { background-color: #f5f5f5; }
          .completed { background-color: #d4edda; }
        </style>
      </head>
      <body>
        <div class="header">
          <h1>Plan de Ahorro Personal</h1>
          <p>Meta: ${formatCurrency(goalAmount)} | Duración: ${totalMonths} meses</p>
          <p>Generado el: ${new Date().toLocaleDateString('es-CO')}</p>
        </div>
        
        <div class="stats">
          <div class="stat-card">
            <h3>Total Ahorrado</h3>
            <p>${formatCurrency(stats.totalSaved)}</p>
          </div>
          <div class="stat-card">
            <h3>Progreso</h3>
            <p>${stats.progress.toFixed(1)}%</p>
          </div>
          <div class="stat-card">
            <h3>Días Completados</h3>
            <p>${stats.completedDays}/${totalDays}</p>
          </div>
          <div class="stat-card">
            <h3>Eficiencia</h3>
            <p>${stats.efficiency.toFixed(0)}%</p>
          </div>
        </div>
        
        <table class="table">
          <thead>
            <tr>
              <th>Día</th>
              <th>Mes</th>
              <th>Meta Diaria</th>
              <th>Ahorrado</th>
              <th>Estado</th>
              <th>Diferencia</th>
            </tr>
          </thead>
          <tbody>
            ${Array.from({length: totalDays}, (_, i) => i + 1).map(day => {
              const month = Math.ceil(day / 30);
              const planned = dailyAmounts[day] || 0;
              const actual = savings[day]?.actualAmount || 0;
              const completed = savings[day]?.completed || false;
              const difference = actual - planned;
              
              return `
                <tr class="${completed ? 'completed' : ''}">
                  <td>${day}</td>
                  <td>${month}</td>
                  <td>${formatCurrency(planned)}</td>
                  <td>${formatCurrency(actual)}</td>
                  <td>${completed ? '✅ Completado' : '⏳ Pendiente'}</td>
                  <td style="color: ${difference >= 0 ? 'green' : 'red'}">${formatCurrency(difference)}</td>
                </tr>
              `;
            }).join('')}
          </tbody>
        </table>
      </body>
      </html>
    `;
    
    const blob = new Blob([htmlContent], { type: 'text/html' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `reporte-ahorro-${new Date().toISOString().split('T')[0]}.html`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    window.URL.revokeObjectURL(url);
  };

  const themes = {
    gradient: 'bg-gradient-to-br from-indigo-50 via-white to-cyan-50',
    dark: 'bg-gradient-to-br from-gray-900 via-gray-800 to-indigo-900 text-white',
    nature: 'bg-gradient-to-br from-green-50 via-emerald-50 to-teal-50',
    sunset: 'bg-gradient-to-br from-orange-50 via-red-50 to-pink-50'
  };

  if (activeView === 'dashboard') {
    return (
      <div className={`min-h-screen ${themes[theme]} transition-all duration-700`}>
        <div className="max-w-7xl mx-auto p-6">
          
          {/* Header Hero */}
          <div className="text-center mb-12">
            <div className="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-r from-blue-600 to-purple-600 rounded-full mb-6">
              <PiggyBank className="w-10 h-10 text-white" />
            </div>
            <h1 className="text-5xl font-bold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent mb-4">
              Savings Tracker Pro
            </h1>
            <p className="text-xl text-gray-600 max-w-2xl mx-auto">
              Transforma tus metas financieras en realidad con seguimiento inteligente y diseño profesional
            </p>
            
            <div className="flex items-center justify-center gap-6 mt-8">
              <div className="flex items-center gap-2 bg-white px-4 py-2 rounded-full shadow-sm">
                <Target className="w-4 h-4 text-blue-600" />
                <span className="font-medium">{formatCurrency(goalAmount)}</span>
              </div>
              <div className="flex items-center gap-2 bg-white px-4 py-2 rounded-full shadow-sm">
                <Calendar className="w-4 h-4 text-purple-600" />
                <span className="font-medium">{totalMonths} meses</span>
              </div>
              <button
                onClick={() => setShowConfig(!showConfig)}
                className="flex items-center gap-2 bg-blue-600 text-white px-6 py-2 rounded-full hover:bg-blue-700 transition-all transform hover:scale-105 shadow-lg"
              >
                <Settings className="w-4 h-4" />
                Configurar
              </button>
            </div>
          </div>

          {/* Config Panel */}
          {showConfig && (
            <div className="bg-white rounded-2xl p-8 mb-12 shadow-xl border border-gray-100">
              <h3 className="text-2xl font-bold text-gray-800 mb-6">Personaliza tu Plan</h3>
              <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <div>
                  <label className="block text-sm font-semibold text-gray-700 mb-3">Meta Financiera</label>
                  <div className="relative">
                    <input
                      type="number"
                      value={goalAmount}
                      onChange={(e) => setGoalAmount(parseInt(e.target.value) || 0)}
                      className="w-full border-2 border-gray-200 rounded-xl px-4 py-3 text-lg font-medium focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                      placeholder="2500000"
                    />
                    <span className="absolute right-3 top-3 text-gray-400">$</span>
                  </div>
                </div>
                
                <div>
                  <label className="block text-sm font-semibold text-gray-700 mb-3">Duración (meses)</label>
                  <div className="flex items-center gap-4">
                    <button onClick={() => setTotalMonths(Math.max(1, totalMonths - 1))} className="w-10 h-10 bg-gray-100 rounded-lg hover:bg-gray-200 flex items-center justify-center">-</button>
                    <span className="text-3xl font-bold text-gray-800 w-12 text-center">{totalMonths}</span>
                    <button onClick={() => setTotalMonths(Math.min(12, totalMonths + 1))} className="w-10 h-10 bg-gray-100 rounded-lg hover:bg-gray-200 flex items-center justify-center">+</button>
                  </div>
                </div>
                
                <div>
                  <label className="block text-sm font-semibold text-gray-700 mb-3">Tema Visual</label>
                  <div className="grid grid-cols-2 gap-2">
                    {Object.entries({gradient: '🌈', dark: '🌙', nature: '🌿', sunset: '🌅'}).map(([key, emoji]) => (
                      <button
                        key={key}
                        onClick={() => setTheme(key)}
                        className={`p-2 rounded-lg text-sm font-medium transition-all ${
                          theme === key ? 'bg-blue-600 text-white' : 'bg-gray-100 hover:bg-gray-200'
                        }`}
                      >
                        {emoji} {key}
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* Stats Dashboard */}
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-12">
            {[
              { icon: DollarSign, label: 'Total Ahorrado', value: formatCurrency(stats.totalSaved), color: 'green', bg: 'from-green-500 to-emerald-600' },
              { icon: TrendingUp, label: 'Progreso', value: `${stats.progress.toFixed(1)}%`, color: 'blue', bg: 'from-blue-500 to-indigo-600' },
              { icon: Calendar, label: 'Días Activos', value: `${stats.completedDays}/${totalDays}`, color: 'purple', bg: 'from-purple-500 to-violet-600' },
              { icon: Zap, label: 'Eficiencia', value: `${stats.efficiency.toFixed(0)}%`, color: 'orange', bg: 'from-orange-500 to-red-600' },
              { icon: Trophy, label: 'Logros', value: `${unlockedAchievements.length}/${achievements.length}`, color: 'yellow', bg: 'from-yellow-500 to-amber-600' }
            ].map((stat, i) => (
              <div key={i} className="group hover:transform hover:scale-105 transition-all duration-300">
                <div className="bg-white rounded-2xl p-6 shadow-lg border border-gray-100 hover:shadow-xl">
                  <div className="flex items-center justify-between mb-4">
                    <div className={`w-12 h-12 bg-gradient-to-r ${stat.bg} rounded-xl flex items-center justify-center shadow-lg`}>
                      <stat.icon className="w-6 h-6 text-white" />
                    </div>
                    <div className="w-2 h-2 bg-gray-200 rounded-full group-hover:bg-green-400 transition-colors"></div>
                  </div>
                  <div className="text-2xl font-bold text-gray-800 mb-1">{stat.value}</div>
                  <div className="text-sm font-medium text-gray-500">{stat.label}</div>
                </div>
              </div>
            ))}
          </div>

          {/* Latest Achievements Banner */}
          {unlockedAchievements.length > 0 && (
            <div className="bg-gradient-to-r from-yellow-400 via-orange-500 to-red-500 rounded-2xl p-6 mb-12 text-white shadow-xl">
              <div className="flex items-center justify-between">
                <div>
                  <h3 className="text-2xl font-bold mb-2">🎉 ¡Logros Desbloqueados!</h3>
                  <p className="text-lg opacity-90">Has ganado {totalPoints} puntos con {unlockedAchievements.length} logros</p>
                </div>
                <div className="flex flex-wrap gap-2">
                  {unlockedAchievements.slice(-3).map((achievement, i) => (
                    <div key={i} className="bg-white bg-opacity-20 backdrop-blur-sm rounded-xl p-3 text-center">
                      <div className="text-2xl mb-1">{achievement.name.split(' ')[0]}</div>
                      <div className="text-xs font-medium">{achievement.points}pts</div>
                    </div>
                  ))}
                  <button
                    onClick={() => setShowAchievements(true)}
                    className="bg-white bg-opacity-20 backdrop-blur-sm rounded-xl p-3 hover:bg-opacity-30 transition-all"
                  >
                    <Trophy className="w-6 h-6" />
                    <div className="text-xs font-medium mt-1">Ver Todos</div>
                  </button>
                </div>
              </div>
            </div>
          )}

          {/* Progress Visualization */}
          <div className="bg-white rounded-2xl p-8 mb-12 shadow-lg border border-gray-100">
            <div className="flex items-center justify-between mb-6">
              <h3 className="text-xl font-bold text-gray-800">Visualización de Progreso</h3>
              <div className="flex flex-wrap gap-2">
                <button
                  onClick={handleExportCSV}
                  className="flex items-center gap-2 bg-gradient-to-r from-green-500 to-emerald-600 text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all text-sm"
                >
                  <Download className="w-4 h-4" />
                  CSV
                </button>
                <button
                  onClick={handleExportJSON}
                  className="flex items-center gap-2 bg-gradient-to-r from-blue-500 to-indigo-600 text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all text-sm"
                >
                  <Download className="w-4 h-4" />
                  JSON
                </button>
                <button
                  onClick={handleExportPDF}
                  className="flex items-center gap-2 bg-gradient-to-r from-purple-500 to-violet-600 text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all text-sm"
                >
                  <Download className="w-4 h-4" />
                  HTML
                </button>
                <button
                  onClick={() => setActiveView('tracker')}
                  className="flex items-center gap-2 bg-gradient-to-r from-orange-500 to-red-600 text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all text-sm"
                >
                  <BarChart3 className="w-4 h-4" />
                  Tracker
                </button>
              </div>
            </div>
            
            <div className="relative mb-6">
              <div className="w-full bg-gray-100 rounded-full h-6">
                <div 
                  className="bg-gradient-to-r from-blue-500 via-purple-500 to-green-500 h-6 rounded-full transition-all duration-1000 relative overflow-hidden"
                  style={{ width: `${Math.min(stats.progress, 100)}%` }}
                >
                  <div className="absolute inset-0 bg-white opacity-20 animate-pulse"></div>
                </div>
              </div>
              <div className="absolute -top-8 left-0 right-0 flex justify-between text-xs text-gray-500">
                <span>Inicio</span>
                <span className="font-medium">{stats.progress.toFixed(1)}%</span>
                <span>Meta: {formatCurrency(goalAmount)}</span>
              </div>
            </div>

            {/* Monthly Progress Cards */}
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
              {stats.monthlyData.map((month, i) => (
                <div key={i} className="bg-gradient-to-br from-gray-50 to-blue-50 rounded-xl p-4 border border-gray-200">
                  <div className="flex items-center justify-between mb-3">
                    <span className="text-sm font-semibold text-gray-700">Mes {month.month}</span>
                    <Star className={`w-4 h-4 ${month.completed === month.total ? 'text-yellow-500' : 'text-gray-300'}`} />
                  </div>
                  <div className="space-y-2">
                    <div className="text-lg font-bold text-gray-800">{formatCurrency(month.saved)}</div>
                    <div className="text-xs text-gray-500">Meta: {formatCurrency(month.goal)}</div>
                    <div className="w-full bg-gray-200 rounded-full h-2">
                      <div 
                        className="bg-gradient-to-r from-blue-400 to-green-400 h-2 rounded-full"
                        style={{ width: `${Math.min((month.saved / month.goal) * 100, 100)}%` }}
                      ></div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* Download Section */}
          <div className="bg-white rounded-2xl p-8 shadow-lg border border-gray-100">
            <h3 className="text-xl font-bold text-gray-800 mb-6">Descargar Datos</h3>
            <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
              <button 
                onClick={handleExportCSV}
                className="bg-gradient-to-br from-green-500 to-green-600 text-white p-6 rounded-xl hover:shadow-lg transition-all transform hover:scale-105"
              >
                <Download className="w-8 h-8 mx-auto mb-2" />
                <div className="font-medium">Descargar CSV</div>
                <div className="text-xs opacity-80 mt-1">Para Excel/Sheets</div>
              </button>
              
              <button 
                onClick={handleExportJSON}
                className="bg-gradient-to-br from-blue-500 to-blue-600 text-white p-6 rounded-xl hover:shadow-lg transition-all transform hover:scale-105"
              >
                <Download className="w-8 h-8 mx-auto mb-2" />
                <div className="font-medium">Descargar JSON</div>
                <div className="text-xs opacity-80 mt-1">Datos completos</div>
              </button>
              
              <button 
                onClick={handleExportPDF}
                className="bg-gradient-to-br from-purple-500 to-purple-600 text-white p-6 rounded-xl hover:shadow-lg transition-all transform hover:scale-105"
              >
                <Download className="w-8 h-8 mx-auto mb-2" />
                <div className="font-medium">Descargar HTML</div>
                <div className="text-xs opacity-80 mt-1">Reporte visual</div>
              </button>
            </div>
            
            <div className="grid grid-cols-2 gap-4">
              <button 
                onClick={() => setActiveView('tracker')}
                className="bg-gradient-to-br from-orange-500 to-orange-600 text-white p-4 rounded-xl hover:shadow-lg transition-all transform hover:scale-105"
              >
                <BarChart3 className="w-6 h-6 mx-auto mb-2" />
                <div className="font-medium">Ver Tracker</div>
              </button>
              
              <button 
                onClick={() => setShowAchievements(true)}
                className="bg-gradient-to-br from-indigo-500 to-indigo-600 text-white p-4 rounded-xl hover:shadow-lg transition-all transform hover:scale-105"
              >
                <Trophy className="w-6 h-6 mx-auto mb-2" />
                <div className="font-medium">Logros ({unlockedAchievements.length})</div>
              </button>
            </div>
          </div>

          {/* Achievements Modal */}
          {showAchievements && (
            <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
              <div className="bg-white rounded-3xl max-w-4xl w-full max-h-[90vh] overflow-hidden">
                <div className="bg-gradient-to-r from-purple-600 via-blue-600 to-indigo-600 text-white p-8">
                  <div className="flex items-center justify-between">
                    <div>
                      <h2 className="text-3xl font-bold mb-2">🏆 Centro de Logros</h2>
                      <p className="text-lg opacity-90">
                        {unlockedAchievements.length}/{achievements.length} logros • {totalPoints} puntos totales
                      </p>
                    </div>
                    <button
                      onClick={() => setShowAchievements(false)}
                      className="w-10 h-10 bg-white bg-opacity-20 rounded-full flex items-center justify-center hover:bg-opacity-30 transition-all"
                    >
                      ✕
                    </button>
                  </div>
                </div>
                
                <div className="p-8 overflow-y-auto max-h-96">
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {achievements.map((achievement, i) => {
                      const rarityStyles = {
                        common: 'from-gray-100 to-gray-200 border-gray-300',
                        uncommon: 'from-green-100 to-green-200 border-green-300',
                        rare: 'from-blue-100 to-blue-200 border-blue-300',
                        epic: 'from-purple-100 to-purple-200 border-purple-300',
                        legendary: 'from-yellow-100 to-yellow-200 border-yellow-400'
                      };
                      
                      const rarityIcons = {
                        common: Medal,
                        uncommon: Award,
                        rare: Star,
                        epic: Gem,
                        legendary: Crown
                      };
                      
                      const RarityIcon = rarityIcons[achievement.rarity];
                      
                      return (
                        <div
                          key={i}
                          className={`
                            rounded-2xl p-6 border-2 transition-all duration-500
                            ${achievement.unlocked 
                              ? `bg-gradient-to-br ${rarityStyles[achievement.rarity]} shadow-lg hover:shadow-xl transform hover:scale-105` 
                              : 'bg-gray-50 border-gray-200 opacity-60'
                            }
                          `}
                        >
                          <div className="flex items-start justify-between mb-4">
                            <div className="flex items-center gap-3">
                              <div className={`
                                w-12 h-12 rounded-full flex items-center justify-center
                                ${achievement.unlocked 
                                  ? 'bg-white shadow-md' 
                                  : 'bg-gray-200'
                                }
                              `}>
                                {achievement.unlocked ? (
                                  <RarityIcon className={`w-6 h-6 ${
                                    achievement.rarity === 'legendary' ? 'text-yellow-600' :
                                    achievement.rarity === 'epic' ? 'text-purple-600' :
                                    achievement.rarity === 'rare' ? 'text-blue-600' :
                                    achievement.rarity === 'uncommon' ? 'text-green-600' :
                                    'text-gray-600'
                                  }`} />
                                ) : (
                                  <div className="w-6 h-6 bg-gray-400 rounded-full opacity-50"></div>
                                )}
                              </div>
                              <div>
                                <div className="font-bold text-gray-800 text-lg">
                                  {achievement.unlocked ? achievement.name : '🔒 Logro Bloqueado'}
                                </div>
                                <div className={`text-xs font-medium uppercase tracking-wider ${
                                  achievement.rarity === 'legendary' ? 'text-yellow-600' :
                                  achievement.rarity === 'epic' ? 'text-purple-600' :
                                  achievement.rarity === 'rare' ? 'text-blue-600' :
                                  achievement.rarity === 'uncommon' ? 'text-green-600' :
                                  'text-gray-600'
                                }`}>
                                  {achievement.rarity}
                                </div>
                              </div>
                            </div>
                            <div className={`
                              px-3 py-1 rounded-full text-sm font-bold
                              ${achievement.unlocked 
                                ? 'bg-white text-gray-800 shadow-sm' 
                                : 'bg-gray-200 text-gray-500'
                              }
                            `}>
                              {achievement.points}pts
                            </div>
                          </div>
                          
                          <p className="text-gray-600 leading-relaxed">
                            {achievement.unlocked ? achievement.description : 'Sigue ahorrando para desbloquear este logro'}
                          </p>
                          
                          {achievement.unlocked && (
                            <div className="mt-4 flex items-center gap-2 text-sm text-green-600">
                              <Check className="w-4 h-4" />
                              <span className="font-medium">Completado</span>
                            </div>
                          )}
                        </div>
                      );
                    })}
                  </div>
                  
                  {/* Achievement Stats */}
                  <div className="mt-8 bg-gradient-to-r from-indigo-50 to-purple-50 rounded-2xl p-6">
                    <h3 className="text-xl font-bold text-gray-800 mb-4">📊 Estadísticas de Logros</h3>
                    <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                      {[
                        { label: 'Total Puntos', value: totalPoints, color: 'text-indigo-600' },
                        { label: 'Desbloqueados', value: `${unlockedAchievements.length}/${achievements.length}`, color: 'text-green-600' },
                        { label: 'Legendarios', value: unlockedAchievements.filter(a => a.rarity === 'legendary').length, color: 'text-yellow-600' },
                        { label: 'Épicos', value: unlockedAchievements.filter(a => a.rarity === 'epic').length, color: 'text-purple-600' }
                      ].map((stat, i) => (
                        <div key={i} className="text-center">
                          <div className={`text-2xl font-bold ${stat.color} mb-1`}>{stat.value}</div>
                          <div className="text-sm text-gray-600">{stat.label}</div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}
        </div>
      </div>
    );
  }

  // Tracker View
  return (
    <div className={`min-h-screen ${themes[theme]} transition-all duration-700`}>
      <div className="max-w-6xl mx-auto p-6">
        
        {/* Navigation */}
        <div className="flex items-center justify-between bg-white rounded-2xl p-4 mb-8 shadow-lg">
          <button 
            onClick={() => setActiveView('dashboard')}
            className="flex items-center gap-2 text-gray-600 hover:text-blue-600 transition-colors"
          >
            ← Dashboard
          </button>
          <h2 className="text-xl font-bold text-gray-800">Tracker Detallado</h2>
          <div className="flex gap-2">
            {Array.from({length: totalMonths}, (_, i) => i + 1).map(month => (
              <button
                key={month}
                onClick={() => setActiveView(`month-${month}`)}
                className={`w-10 h-10 rounded-lg font-medium transition-all ${
                  activeView === `month-${month}` 
                    ? 'bg-blue-600 text-white shadow-lg' 
                    : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
                }`}
              >
                {month}
              </button>
            ))}
          </div>
        </div>

        {/* Month View */}
        {activeView.startsWith('month-') && (
          <div className="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
            <div className="bg-gradient-to-r from-blue-600 to-purple-600 text-white p-6">
              <h3 className="text-2xl font-bold">Mes {activeView.split('-')[1]}</h3>
              <p>Meta mensual: {formatCurrency(stats.monthlyData[parseInt(activeView.split('-')[1]) - 1]?.goal || 0)}</p>
            </div>
            
            <div className="p-6">
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {getMonthDays(parseInt(activeView.split('-')[1])).map(day => {
                  const planned = dailyAmounts[day] || 0;
                  const actual = savings[day]?.actualAmount || 0;
                  const completed = savings[day]?.completed || false;
                  
                  return (
                    <div key={day} className={`p-4 rounded-xl border-2 transition-all hover:shadow-md ${
                      completed 
                        ? 'border-green-200 bg-green-50' 
                        : 'border-gray-200 bg-gray-50 hover:border-blue-200'
                    }`}>
                      <div className="flex items-center justify-between mb-3">
                        <span className="font-bold text-gray-800">Día {day}</span>
                        <button
                          onClick={() => toggleCompleted(day)}
                          className={`w-8 h-8 rounded-full border-2 flex items-center justify-center transition-all ${
                            completed 
                              ? 'bg-green-500 border-green-500 text-white' 
                              : 'border-gray-300 hover:border-green-400'
                          }`}
                        >
                          {completed && <Check className="w-4 h-4" />}
                        </button>
                      </div>
                      
                      <div className="space-y-2">
                        <div className="text-sm text-gray-600">Meta: {formatCurrency(planned)}</div>
                        <input
                          type="number"
                          value={actual || ''}
                          onChange={(e) => updateSaving(day, 'actualAmount', parseInt(e.target.value) || 0)}
                          className="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500"
                          placeholder="Monto ahorrado"
                        />
                        <input
                          type="date"
                          value={savings[day]?.date || ''}
                          onChange={(e) => updateSaving(day, 'date', e.target.value)}
                          className="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500"
                        />
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          </div>
        )}

      </div>
    </div>
  );
};
